# Deny all access — internal architecture notes, not public documentation.
# Markdown is served as plain text, so without this the whole design doc
# (meta keys, filter names, storage layout) is readable by anyone.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
